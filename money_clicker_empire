<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Money Clicker: Empire Edition</title>
<style>
:root{color-scheme:dark;--bg:#0b1220;--panel:#17243a;--panel2:#20334e;--line:#38516f;--gold:#ffc857;--mint:#6ee7b7;--muted:#a9bad0;--white:#f6f8fc}
*{box-sizing:border-box}body{margin:0;padding:18px;background:radial-gradient(ellipse at 50% -10%,#36547c,#111d31 48%,#080e19);font-family:system-ui,Segoe UI,sans-serif;color:var(--white)}
main{max-width:900px;margin:auto}
header{text-align:center;margin:12px 0 18px}h1{font-size:clamp(2rem,6vw,3.2rem);margin:5px}.tag{display:inline-block;border-radius:99px;background:#174d3c;color:#9af5cb;padding:6px 13px;font-size:.76rem;font-weight:900;letter-spacing:.12em}
.panel{background:linear-gradient(145deg,#1b2b43f5,#142136f5);border:1px solid var(--line);border-radius:19px;padding:18px;margin:13px 0;box-shadow:0 12px 28px #0003}.balance{text-align:center;background:linear-gradient(135deg,#2a4563,#192c44)}.money{font-size:clamp(2.5rem,9vw,4.2rem);font-weight:950;color:var(--mint);font-variant-numeric:tabular-nums}.rate{font-weight:900;color:#9af5cb;font-size:1.15rem}.muted{color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:15px}.stat{background:#101c2e;border:1px solid #304763;border-radius:13px;padding:11px;text-align:center}.stat strong{display:block;font-size:1.22rem}.stat span{font-size:.75rem;color:var(--muted)}
.click-wrap{text-align:center;position:relative;overflow:hidden}.coin{width:168px;height:168px;border:4px solid #ffe5a1;border-radius:50%;background:radial-gradient(circle at 32% 25%,#fff0b5,#ffca4e 48%,#c47b14 83%);box-shadow:0 9px 0 #86500d,0 17px 28px #0007,inset 0 0 0 7px #f5b638;color:#fff;font-size:2.6rem;font-weight:1000;cursor:pointer;text-shadow:0 2px 3px #89530c;transition:transform .08s}.coin:active{transform:translateY(6px) scale(.97);box-shadow:0 3px 0 #86500d,0 8px 14px #0007}.coin small{display:block;font-size:.78rem;letter-spacing:.12em}
.tabs{display:flex;gap:8px;margin:14px 0}.tab{flex:1;background:#20334e;color:white;border:1px solid var(--line);border-radius:12px;padding:13px 7px;font-weight:850;cursor:pointer}.tab.active{background:#3a5d83;border-color:#9dbce0}
.shopitem{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#101c2e;border:1px solid #304763;border-radius:15px;padding:13px;margin:10px 0}.shopitem h3{margin:0 0 4px;font-size:1.02rem}.shopitem p{margin:3px 0;color:var(--muted);font-size:.86rem}.buy,.action{border:0;border-radius:11px;padding:11px 14px;font-weight:900;color:#fff;cursor:pointer;background:linear-gradient(135deg,#29986d,#18744f);min-width:126px}.buy:disabled,.action:disabled{opacity:.38;cursor:not-allowed}.action{width:100%;background:linear-gradient(135deg,#527caf,#34577f);font-size:1rem;padding:14px}.hidden{display:none}.notice{min-height:26px;text-align:center;color:#ffe4a3;font-weight:700}.progress{height:10px;background:#0b1524;border-radius:99px;overflow:hidden;margin:8px 0}.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,#39c98a,#ffe07a);border-radius:99px;transition:width .2s}.achievement{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px;border-bottom:1px solid #304763}.achievement:last-child{border:0}.unlocked{color:#9af5cb}.foot{text-align:center;color:var(--muted);font-size:.8rem;margin:18px}
@media(max-width:560px){body{padding:10px}.stats{grid-template-columns:repeat(2,1fr)}.shopitem{align-items:stretch;flex-direction:column}.buy{width:100%}.tabs{gap:5px}.tab{font-size:.82rem}}
</style></head><body><main>
<header><div class="tag">EMPIRE EDITION</div><h1>💰 Money Clicker</h1><div class="muted">Tap your way from pocket change to a money empire.</div></header>
<section class="panel balance"><div class="muted">YOUR CASH</div><div class="money" id="coins">$0</div><div class="rate" id="rate">+$0 / sec</div>
<div class="stats"><div class="stat"><strong id="power">1</strong><span>Cash per tap</span></div><div class="stat"><strong id="owned">0</strong><span>Businesses</span></div><div class="stat"><strong id="rebirths">0</strong><span>Prestiges</span></div><div class="stat"><strong id="mult">x1</strong><span>Global boost</span></div></div>
<p class="muted" style="margin-bottom:0">Lifetime earned: <b id="total">$0</b></p></section>
<section class="panel click-wrap"><div style="font-size:1.15rem;font-weight:900;margin-bottom:6px">⭐ LEVEL <span id="playerLevel">1</span></div><div class="progress" style="max-width:420px;margin:8px auto"><i id="levelProgress"></i></div><p class="muted" id="xpText">0 / 10 XP to next level</p><button class="coin" id="clicker">💰<small>TAP!</small></button><p class="muted">Every tap earns <b id="tapValue">$1</b> and gives you 1 XP!</p></section>
<nav class="tabs"><button class="tab active" data-tab="shop">🛍️ Shop</button><button class="tab" data-tab="upgrades">⚡ Upgrades</button><button class="tab" data-tab="prestige">🌟 Prestige</button><button class="tab" data-tab="achievements">🏆 Awards</button></nav>
<section class="panel" id="shop"><h2>🏭 Build your empire</h2><p class="muted">Businesses earn cash automatically, even while you are away.</p><div id="businessList"></div></section>
<section class="panel hidden" id="upgrades"><h2>⚡ Power upgrades</h2><p class="muted">Permanent boosts for this run.</p><div id="upgradeList"></div></section>
<section class="panel hidden" id="prestige"><h2>🌟 Prestige</h2><p class="muted">Trade your current run for a permanent multiplier. Your lifetime earnings and prestige boosts stay forever.</p><p>Current boost: <b class="rate" id="prestigeMult">x1</b></p><p>Prestige requirement: <b id="prestigeCost">$100K</b></p><div class="progress"><i id="prestigeProgress"></i></div><p class="muted" id="prestigeHint">Earn more cash to unlock prestige.</p><button class="action" id="doPrestige">🌟 PRESTIGE</button></section>
<section class="panel hidden" id="achievements"><h2>🏆 Achievements</h2><p class="muted">Little milestones on the way to becoming a tycoon.</p><div id="achievementList"></div></section>
<section class="panel"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap"><span class="muted" id="saveStatus">● Auto-save on</span><button class="tab" id="reset">Reset game</button></div></section>
<div class="notice" id="notice" aria-live="polite">Welcome, future tycoon! Your first dollar is one tap away.</div><div class="foot">Progress saves automatically on this device · Offline earnings are included</div>
</main>
<script>
const businesses=[
{name:"Lemonade Stand",emoji:"🍋",base:15,rate:0.2,desc:"A tiny stand with big dreams."},
{name:"Food Truck",emoji:"🚚",base:100,rate:1.5,desc:"Serve snacks and stack cash."},
{name:"Arcade",emoji:"🕹️",base:750,rate:10,desc:"Let the games pay you."},
{name:"Tech Startup",emoji:"💻",base:5000,rate:65,desc:"Your apps are taking off."},
{name:"Skyscraper",emoji:"🏙️",base:35000,rate:400,desc:"Rent out an entire tower."},
{name:"Space Casino",emoji:"🚀",base:250000,rate:3000,desc:"A business that's out of this world."}
];
const upgrades=[
{name:"Golden Fingers",desc:"Double your tap earnings.",cost:250,type:"click",factor:2},
{name:"Efficient Teams",desc:"All businesses earn 50% more.",cost:1500,type:"income",factor:1.5},
{name:"Money Magnet",desc:"Double your tap earnings again.",cost:12000,type:"click",factor:2},
{name:"Worldwide Brand",desc:"All businesses earn 2× more.",cost:80000,type:"income",factor:2},
{name:"Midas Touch",desc:"Triple tap earnings.",cost:500000,type:"click",factor:3}
];
const achievements=[["First Dollar",1,"Earn $1 lifetime"],["Getting Started",100,"Earn $100 lifetime"],["Small Business",1000,"Earn $1K lifetime"],["Big Leagues",100000,"Earn $100K lifetime"],["Millionaire",1000000,"Earn $1M lifetime"],["Empire Builder",10000000,"Earn $10M lifetime"]];
const fresh=()=>({cash:0,total:0,taps:0,level:1,xp:0,prestiges:0,mult:1,clickPower:1,counts:Array(6).fill(0),bought:[],last:Date.now()});
let g={...fresh(),...(JSON.parse(localStorage.getItem("moneyClickerEmpire")||"null")||{})};
if(!Array.isArray(g.counts)||g.counts.length!==6)g.counts=Array(6).fill(0);
if(typeof g.level!=="number")g.level=1;
if(typeof g.xp!=="number")g.xp=0;
if(!Array.isArray(g.bought))g.bought=[];
if(!Array.isArray(g.upgradeLevels)) {
  g.upgradeLevels=upgrades.map((_,i)=>g.bought.includes(i)?1:0);
}
const upgradeCost=(u,i)=>Math.ceil(u.cost*Math.pow(2.35,g.upgradeLevels[i]||0));
const $=id=>document.getElementById(id), fmt=n=>{if(n>=1e12)return "$"+(n/1e12).toFixed(2)+"T";if(n>=1e9)return "$"+(n/1e9).toFixed(2)+"B";if(n>=1e6)return "$"+(n/1e6).toFixed(2)+"M";if(n>=1e3)return "$"+(n/1e3).toFixed(2)+"K";return "$"+Math.floor(n).toLocaleString()};
const cost=(b,i)=>Math.ceil(b.base*Math.pow(1.16,g.counts[i]));
function income(){return businesses.reduce((s,b,i)=>s+b.rate*g.counts[i],0)*g.mult*upgrades.reduce((v,u,i)=>u.type==="income"?v*Math.pow(u.factor,g.upgradeLevels[i]||0):v,1)}
function clickValue(){return g.clickPower*g.mult*(1+Math.max(0,g.level-1)*0.05)*upgrades.reduce((v,u,i)=>u.type==="click"?v*Math.pow(u.factor,g.upgradeLevels[i]||0):v,1)}
function xpNeeded(){return 10+(g.level-1)*5}
function addClickXP(){g.xp++;while(g.xp>=xpNeeded()){g.xp-=xpNeeded();g.level++;note("⭐ LEVEL UP! You reached level "+g.level+"! Click power increased by 5%.")}}
function save(){g.last=Date.now();localStorage.setItem("moneyClickerEmpire",JSON.stringify(g));$("saveStatus").textContent="● Saved just now"}
function note(t){$("notice").textContent=t}
function earn(n){g.cash+=n;g.total+=n}
function render(){
$("playerLevel").textContent=g.level;$("levelProgress").style.width=(g.xp/xpNeeded()*100)+"%";$("xpText").textContent=g.xp+" / "+xpNeeded()+" XP to next level";
$("coins").textContent=fmt(g.cash);$("rate").textContent="+"+fmt(income())+" / sec";$("power").textContent=fmt(clickValue());$("tapValue").textContent=fmt(clickValue());$("owned").textContent=g.counts.reduce((a,b)=>a+b,0);$("rebirths").textContent=g.prestiges;$("mult").textContent="x"+g.mult.toLocaleString();$("total").textContent=fmt(g.total);
$("businessList").innerHTML=businesses.map((b,i)=>{let c=cost(b,i),ok=g.cash>=c;return `<div class="shopitem"><div><h3>${b.emoji} ${b.name}</h3><p>${b.desc}</p><p>Owned: <b>${g.counts[i]}</b> · Earns ${fmt(b.rate*g.mult)} / sec each</p><p>Next cost: <b>${fmt(c)}</b></p></div><button class="buy" data-buy="${i}" ${ok?"":"disabled"}>Buy</button></div>`}).join("");
$("upgradeList").innerHTML=upgrades.map((u,i)=>{let level=g.upgradeLevels[i]||0,c=upgradeCost(u,i);return `<div class="shopitem"><div><h3>⚡ ${u.name}</h3><p>${u.desc}</p><p>Level: <b class="unlocked">${level}</b> · Next cost: <b>${fmt(c)}</b></p><p class="muted">Effect: ${u.type==="click"?"Tap power":"Business income"} ×${Math.pow(u.factor,level).toLocaleString(undefined,{maximumFractionDigits:2})}</p></div><button class="buy" data-upgrade="${i}" ${g.cash<c?"disabled":""}>Buy level ${level+1}</button></div>`}).join("");
let pc=100000*Math.pow(5,g.prestiges),pct=Math.min(100,g.cash/pc*100);$("prestigeMult").textContent="x"+g.mult;$("prestigeCost").textContent=fmt(pc);$("prestigeProgress").style.width=pct+"%";$("prestigeHint").textContent=pct>=100?"Prestige is ready!":Math.floor(pct)+"% of the way there.";$("doPrestige").disabled=g.cash<pc;
$("achievementList").innerHTML=achievements.map(a=>{let done=g.total>=a[1];return `<div class="achievement"><span>${done?"🏅":"🔒"} <b class="${done?"unlocked":""}">${a[0]}</b><br><small class="muted">${a[2]}</small></span><span>${done?"Unlocked":"In progress"}</span></div>`}).join("");
document.querySelectorAll("[data-buy]").forEach(b=>b.onclick=()=>{let i=+b.dataset.buy,c=cost(businesses[i],i);if(g.cash>=c){g.cash-=c;g.counts[i]++;note(businesses[i].emoji+" "+businesses[i].name+" purchased!");render();save()}});
document.querySelectorAll("[data-upgrade]").forEach(b=>b.onclick=()=>{let i=+b.dataset.upgrade,u=upgrades[i],c=upgradeCost(u,i);if(g.cash>=c){g.cash-=c;g.upgradeLevels[i]=(g.upgradeLevels[i]||0)+1;note("⚡ "+u.name+" upgraded to level "+g.upgradeLevels[i]+"!");render();save()}});
save();
}
$("clicker").onclick=()=>{let v=clickValue();earn(v);g.taps++;addClickXP();$("clicker").style.transform="scale(.96)";setTimeout(()=>$("clicker").style.transform="",80);render()};
$("doPrestige").onclick=()=>{let pc=100000*Math.pow(5,g.prestiges);if(g.cash<pc)return;g.prestiges++;g.mult*=2;g.cash=0;g.total=0;g.taps=0;g.level=1;g.xp=0;g.clickPower=1;g.counts=Array(6).fill(0);g.bought=[];g.upgradeLevels=upgrades.map(()=>0);note("🌟 PRESTIGE! Everything reset — your permanent money multiplier doubled to x"+g.mult+"!");render();save()};
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===b));["shop","upgrades","prestige","achievements"].forEach(id=>$(id).classList.toggle("hidden",id!==b.dataset.tab))});
$("reset").onclick=()=>{if(confirm("Reset all your money, businesses and prestige progress?")){g=fresh();note("A brand new empire begins!");render()}};
let old=g.last||Date.now(),away=Math.max(0,Math.min(8*60*60*1000,Date.now()-old));if(away>5000){let gain=income()*away/1000;earn(gain);note("Welcome back! Your businesses earned "+fmt(gain)+" while you were away.");}
let previous=Date.now();setInterval(()=>{let now=Date.now(),dt=Math.min(5,(now-previous)/1000);previous=now;let gain=income()*dt;if(gain>0){earn(gain);render()}},250);
render();
</script></body></html>
